/*
Pattern: Greedy

Idea:
- Traverse the array once.
- Keep track of the lowest buying price seen so far.
- For each day, calculate the profit if selling on that day.
- Update the maximum profit.
- If a lower price is found, update the buying day.

Key Insight:
- The best buying price for today is always the minimum price seen before today.
- Calculate profit at every day instead of checking every buy-sell pair.

Key STL:
vector<int>, vector<int>::iterator

Time: O(n)
Space: O(1)

Mistakes:
- I first used iterators, which made the code more complicated.
- I focused on tracking both buy and sell iterators instead of just the minimum price.

Takeaway:
- When the answer depends on the minimum value seen so far, keep updating that minimum while traversing the array.
*/
class Solution {
public:
    int maxProfit(vector<int>& prices) {
        vector<int>::iterator buyday = prices.begin();
        vector<int>::iterator sellday = prices.begin();
        int max = 0;
        for (int i = 0; i < prices.size(); i++)
        {
            buyday = *buyday < prices[i] ? buyday : prices.begin() + i;
            sellday = *sellday > prices[i] ? sellday : prices.begin() + i;
            if (buyday <= sellday)
                max = max >= *sellday - *buyday ? max : *sellday - *buyday;
            else
                sellday = buyday;
        }
        return max;
    }
};
